# GEMINI_API_KEY: Required for Gemini AI timetable parsing calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Google Maps Platform API Key (server + optional Vite client key)
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Cloud SQL / PostgreSQL connection variables
SQL_HOST="127.0.0.1"
SQL_DB_NAME="nucespool"
SQL_USER="app_user"
SQL_PASSWORD="MY_SQL_PASSWORD"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
